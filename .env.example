DATABASE_URL=postgresql://eb:CHANGE_ME@localhost:55433/egypt_beyond_dev?schema=public
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
MAIL_TRANSPORT=log
JWT_PRIVATE_KEY_B64=CHANGE_ME
JWT_PUBLIC_KEY_B64=CHANGE_ME
JWT_ISSUER=CHANGE_ME
JWT_AUDIENCE=CHANGE_ME
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
DEFAULT_CAR_MIN_DRIVER_AGE=21
MEDIA_CDN_BASE_URL=https://cdn.egyptbeyond.example
PRISMA_QUERY_EVENTS=false

# Milestone 5: InstaPay receipts (private) and the hold-expiration scheduler.
PAYMENT_PROOF_DIR=var/payment-proofs
PAYMENT_PROOF_MAX_BYTES=5242880
HOLD_SCHEDULER_ENABLED=true
HOLD_SCHEDULER_INTERVAL_MS=60000

# Milestone 6: admin-uploaded public catalogue images.
PUBLIC_MEDIA_DIR=var/public-media
PUBLIC_MEDIA_MAX_BYTES=8388608
